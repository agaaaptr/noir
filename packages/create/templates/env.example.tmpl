# .noir/.env.example — copy to `.noir/.env` and fill in real values.
# `.noir/.env` is gitignored — NEVER commit real tokens. Real environment
# variables always win over this file (it fills only unset keys).
#
# noir-clickup integration (only if you use the noir-clickup skill):
# CLICKUP_API_TOKEN=pk_00000000000000000000000000000000
#
# CLICKUP_TEAM_ID is NOT an env var — set it as a config.yml key instead:
#   integrations:
#     clickup:
#       teamId: "ABC123"   # optional — only for custom task IDs (#ABC-123)
