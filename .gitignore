# Node-provision / test-run temp files+dirs (names derive from process.pid +
# Date.now(), so they can never be a stable match otherwise — safety net against
# `git add -A`). No trailing slash: node-provision writes `.archive-<pid>-<ts>.tmp`
# as a FILE, while the test double extracts into a DIRECTORY of the same shape.
.archive-*.tmp
.staging-*

# OS / editor
.DS_Store

# Build / dependencies
node_modules/
dist/
*.tsbuildinfo
coverage/
*.tgz

# Release pack output (pnpm pack --pack-destination)
artifacts/

# Noir runtime embedding/dedup cache (regenerable). Core fix landed in source and
# ships in 1.19.4; this manual line bridges until the next `noir sync` emits it.
.noir/dedup-cache.json

# Claude Code local settings (permissions + the noir hook): local-only, never commit.
.claude/settings.local.json

# >>> noir:ignore >>>
/.noir/store/
/.noir/handoff/
/.noir/.env
/.noir/.env.*
!/.noir/.env.example
/.noir/transcripts/
/.noir/audit/integration-*.jsonl
# <<< noir:ignore <<<
