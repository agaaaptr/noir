# Local SDD / superpowers scratch (session planning state, not source)
.superpowers/

# Node-provision / test-run temp dirs (names derive from process.pid + Date.now(),
# so they can never be a stable match otherwise — safety net against `git add -A`).
.archive-*.tmp/
.staging-*

# OS / editor
.DS_Store

# Build / dependencies
node_modules/
dist/
*.tsbuildinfo
coverage/
*.tgz

# Release pack output (pnpm pack --pack-destination)
artifacts/

# Noir local runtime data (the SQLite store; .noir/config.yml, .noir/NOIR.md,
# .noir/specs, .noir/plans, etc. are project state and may be committed).
.noir/store/
# Dogfooding secrets — a dev's local .noir/.env must never be committed.
.noir/.env
.noir/.env.*
!.noir/.env.example
# `noir run` transcripts contain raw host prompts/output (may include secrets).
.noir/transcripts/
