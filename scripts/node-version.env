# scripts/node-version.env — the single source of truth for the managed-Node
# version Noir provisions into ~/.noir/runtime/v<version>/.
#
# Sourced by BOTH install.sh (bash) and install.ps1 (PowerShell), and mirrored
# by @noir-ai/core's MANAGED_NODE_VERSION constant
# (packages/core/src/node-provision.ts). Bump all three together to move Noir
# onto a newer Node LTS.
#
# Format is intentionally `KEY=VALUE` (no `export`), so:
#   - bash:    `set -a; . ./scripts/node-version.env; set +a`
#   - PowerShell: parse each `KEY=VALUE` line (see install.ps1's Load-NodeEnv).
# Comments (`#`) and blank lines are ignored by both loaders.

# Node 22 LTS (codename Jod) — active LTS, best prebuild coverage for
# better-sqlite3@13 / onnxruntime-node, matches the package `engines >= 22`.
MANAGED_NODE_VERSION=22.23.2

# Node.js distribution root for the archive + SHASUMS256.txt fetch. Override
# via the NOIR_NODE_DIST_URL env var (mirrors @noir-ai/core's nodeDistBaseUrl())
# for mirrors such as https://mirrors.aliyun.com/nodejs-dist/.
NODE_DIST_BASE_URL=https://nodejs.org/dist
