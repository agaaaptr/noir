{
  "name": "noir",
  "private": true,
  "version": "0.1.0",
  "description": "Noir — the discipline, context, and memory layer for any agentic CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "release:bump": "node scripts/bump-version.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "release:compute": "node scripts/compute-version.mjs",
    "release:history": "node scripts/release-registry.mjs history",
    "release:rebuild": "node scripts/release-registry.mjs rebuild",
    "release:validate": "node scripts/release-registry.mjs validate",
    "docs:generate": "node scripts/docs-generate.mjs generate",
    "docs:validate": "node scripts/docs-generate.mjs validate",
    "docs:registry": "node scripts/docs-generate.mjs registry",
    "docs:index": "node scripts/docs-generate.mjs index"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "protobufjs"
    ],
    "overrides": {
      "sharp": ">=0.35.0",
      "@hono/node-server": ">=2.0.5",
      "esbuild": ">=0.28.1",
      "vite": ">=6.4.3"
    }
  }
}
